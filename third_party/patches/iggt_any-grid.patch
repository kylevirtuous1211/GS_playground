+def pad_to_window(x, window_size):
+    """GS_playground: reflect-pad (B, C, H, W) on the bottom and right to multiples of the window, as
+    HAT's own check_image_size does; IGGT dropped it, so only an even patch grid (504x336) ran."""
+    pad_h, pad_w = (-x.shape[-2]) % window_size, (-x.shape[-1]) % window_size
+    return torch.nn.functional.pad(x, (0, pad_w, 0, pad_h), mode="reflect") if pad_h or pad_w else x
+
+
 def window_partition(x, window_size):
