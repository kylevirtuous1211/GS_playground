     return kwargs
 
 
+def _vram_start() -> None:
+    """Open a peak-VRAM window (GS_playground): drop the allocator cache the
+    DA3 expert leaves behind, so it is not charged to the ODE, then reset."""
+    if torch.cuda.is_available():
+        torch.cuda.empty_cache()
+        torch.cuda.reset_peak_memory_stats()
+
+
+def _vram_peaks() -> Dict[str, float]:
+    """Peak reserved and allocated VRAM in GiB since `_vram_start`."""
+    if not torch.cuda.is_available():
+        return {}
+    return {"peak_vram_ode_gib": torch.cuda.max_memory_reserved() / 2**30,
+            "peak_alloc_ode_gib": torch.cuda.max_memory_allocated() / 2**30}
+
+
+def _save_guided_state(
+    path: Path, *, batch: dict, scene_idx: int, result: Dict[str, Any],
+    selected: list,
+) -> None:
+    """Everything needed to rebuild the fitted 3DGS outside Surflo (GS_playground).
+
+    Guided: the Gaussians as the guided inference returns them (world space,
+    scales already divided by scene_scale), the refined cameras they were
+    rendered against, and the supervision images, in the order of ``selected``.
+    Plain (``result`` empty): only VGGT's cameras, which is what aligns a plain
+    point cloud to anything else.
+    """
+    cams = build_refined_cameras_from_guided_result(
+        batch, scene_idx, result, apply_camera_correction=bool(result), data_device="cpu",
+    )
+    keys = ("aux_means", "aux_scales", "aux_quats", "aux_opacities",
+            "aux_colors", "aux_colors_sh", "aux_exposure_coeffs")
+    state: Dict[str, Any] = {
+        k: result[k].detach().cpu() for k in keys if result.get(k) is not None
+    }
+    if result:
+        state["supervision_images"] = [im.detach().cpu() for im in result["supervision_images"]]
+    state["cameras"] = [
+        dict(R=np.asarray(c.R), T=np.asarray(c.T), FoVx=float(c.FoVx), FoVy=float(c.FoVy),
+             width=int(c.image_width), height=int(c.image_height),
+             image_name=str(c.image_name))
+        for c in cams
+    ]
+    state["selected_images"] = [str(p) for p in selected]
+    torch.save(state, path)
+    _log.info(f"[infer] wrote {path.name}: "
+              f"{state['aux_means'].shape[0] if result else 0} Gaussians, {len(cams)} cameras.")
+
+
