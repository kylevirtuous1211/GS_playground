+def load_vggt_weights(vggt: torch.nn.Module, path: str) -> list:
+    """Replace the VGGT backbone's weights with another VGGT-architecture
+    checkpoint (GS_playground), e.g. IGGT's fine-tuned backbone.
+
+    A ``module.`` (DataParallel) prefix is stripped. Keys outside VGGT (IGGT's
+    ``part_head.*`` / ``part_adaptor.*``) are dropped and returned; every VGGT
+    parameter and buffer must be present with its shape (``strict=True``), so a
+    wrong prefix fails loudly instead of leaving the backbone untouched.
+    """
+    state = torch.load(path, map_location="cpu", mmap=True, weights_only=True)
+    state = {k.removeprefix("module."): v for k, v in state.items()}
+    own = vggt.state_dict()
+    dropped = sorted(k for k in state if k not in own)
+    vggt.load_state_dict({k: v for k, v in state.items() if k in own}, strict=True)
+    _log.info(f"Loaded VGGT weights from {path} ({len(own)} tensors); "
+              f"dropped {len(dropped)} keys outside VGGT.")
+    return dropped
+
+
